# --- Banco e fila ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=minha_ia
POSTGRES_USER=minha_ia
POSTGRES_PASSWORD=trocar
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
JWT_SECRET=trocar
CREDITS_ENFORCED=true
# Reservas órfãs sem commit são estornadas após este prazo (minutos).
RECONCILE_STALE_MINUTES=30
RECONCILE_INTERVAL_SECONDS=300
IMAGE_GENERATION_ENABLED=true
# E5: video/animar foto implementados. Sem chave do provedor o backend devolve
# 503 em QUALQUER ambiente (F0): nenhum video simulado é entregue como real.
VIDEO_GENERATION_ENABLED=true
AUDIO_GENERATION_ENABLED=false
AVATAR_ENABLED=false
PAYMENTS_ENABLED=false

# --- Autenticação (E2) ---
# "dev" habilita token dev:<email>:<nonce> sem Firebase (bloqueado em production).
# "firebase" exige FIREBASE_PROJECT_ID + FIREBASE_SERVICE_ACCOUNT_JSON.
AUTH_PROVIDER=dev

# --- Firebase (somente backend) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=

# --- Cloud Storage ---
GCS_BUCKET=
GCS_CORS_ORIGINS=http://localhost

# --- Provedores de IA (somente backend) ---
# F0: mocks de midia são DESLIGADOS por padrão. "auto" sempre escolhe um
# provedor real; sem chave, a rota falha com 503 em dev e em produção.
# ALLOW_MOCK_PROVIDERS=true habilita mock APENAS para testes locais e nunca
# em produção (o guard de configuração recusa o boot).
ALLOW_MOCK_PROVIDERS=false
# D1: imagem = OpenAI GPT Image.
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER_TIMEOUT_SECONDS=30
IMAGE_GATEWAY_TIMEOUT_SECONDS=25
IMAGE_PROVIDER_RETRIES=2
MEDIA_ROOT=backend/media
MEDIA_URL_PREFIX=/media
# D2: video = fal.ai + Kling. "auto" sempre usa fal.ai; sem FAL_API_KEY,
# falha fechado com 503. Mock somente com ALLOW_MOCK_PROVIDERS=true.
VIDEO_PROVIDER=auto
FAL_API_KEY=
FAL_VIDEO_TEXT_MODEL=fal-ai/kling-video/v3/pro/text-to-video
FAL_VIDEO_IMAGE_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# URL publica do webhook (preferencial sobre polling na E5).
FAL_WEBHOOK_URL=
# Se preenchido, o X-Fal-Webhook-User-Id recebido precisa coincidir.
FAL_WEBHOOK_USER_ID=
FAL_JWKS_URL=https://rest.fal.ai/.well-known/jwks.json
VIDEO_PROVIDER_TIMEOUT_SECONDS=30
VIDEO_PROVIDER_RETRIES=2
VIDEO_MAX_DURATION_SECONDS=30
# Polling de fallback (webhook e preferencial quando FAL_WEBHOOK_URL existe).
VIDEO_POLL_ATTEMPTS=60
VIDEO_POLL_INTERVAL_SECONDS=2
# Upload de imagem para animar foto: MIME e tamanho validados no backend.
UPLOAD_MAX_BYTES=10485760
WEBHOOK_SIGNATURE_LEEWAY_SECONDS=300
JWKS_CACHE_TTL_SECONDS=3600
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=

# --- Pagamentos (somente backend) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Observabilidade (F0) ---
# Sentry só é inicializado quando SENTRY_DSN está preenchida.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

# --- Worker / Compose (F0) ---
# Limites reais do Celery: um job preso é cancelado e reenfileirado.
WORKER_SOFT_TIMEOUT_SECONDS=900
WORKER_HARD_TIMEOUT_SECONDS=960
# Bind da API no host. Em produção use 127.0.0.1:8000 atrás de proxy reverso.
API_HOST_PORT=8000

# --- Producao (docker-compose.prod.yml) ---
# O compose exige todas as variáveis abaixo e o backend valida no boot:
# JWT_SECRET (>=32 caracteres, não padrão), POSTGRES_PASSWORD (não padrão),
# AUTH_PROVIDER=firebase, FIREBASE_PROJECT_ID, FIREBASE_SERVICE_ACCOUNT_JSON,
# OPENAI_API_KEY, FAL_API_KEY e FAL_WEBHOOK_USER_ID (identidade da conta fal.ai).
