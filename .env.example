# --- Banco e fila ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=minha_ia
POSTGRES_USER=minha_ia
POSTGRES_PASSWORD=trocar
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
JWT_SECRET=trocar
CREDITS_ENFORCED=true
# Reservas órfãs sem commit são estornadas após este prazo (minutos).
RECONCILE_STALE_MINUTES=30
RECONCILE_INTERVAL_SECONDS=300
IMAGE_GENERATION_ENABLED=true
# E5: video/animar foto implementados. Em producao sem FAL_API_KEY o backend
# devolve 503 (fail-closed); em dev, VIDEO_PROVIDER=auto usa o mock.
VIDEO_GENERATION_ENABLED=true
AUDIO_GENERATION_ENABLED=false
AVATAR_ENABLED=false
PAYMENTS_ENABLED=false

# --- Autenticação (E2) ---
# "dev" habilita token dev:<email>:<nonce> sem Firebase (bloqueado em production).
# "firebase" exige FIREBASE_PROJECT_ID + FIREBASE_SERVICE_ACCOUNT_JSON.
AUTH_PROVIDER=dev

# --- Firebase (somente backend) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=

# --- Cloud Storage ---
GCS_BUCKET=
GCS_CORS_ORIGINS=http://localhost

# --- Provedores de IA (somente backend) ---
# D1: imagem = OpenAI GPT Image. auto usa OpenAI quando ha chave e mock em dev;
# mock e recusado quando APP_ENV=production (falha fechado com 503).
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER_TIMEOUT_SECONDS=30
IMAGE_GATEWAY_TIMEOUT_SECONDS=25
IMAGE_PROVIDER_RETRIES=2
MEDIA_ROOT=backend/media
MEDIA_URL_PREFIX=/media
# D2: video = fal.ai + Kling. auto usa fal.ai quando ha chave e mock em dev;
# mock e recusado quando APP_ENV=production (falha fechado com 503).
VIDEO_PROVIDER=auto
FAL_API_KEY=
FAL_VIDEO_TEXT_MODEL=fal-ai/kling-video/v3/pro/text-to-video
FAL_VIDEO_IMAGE_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# URL publica do webhook (preferencial sobre polling na E5).
FAL_WEBHOOK_URL=
# Se preenchido, o X-Fal-Webhook-User-Id recebido precisa coincidir.
FAL_WEBHOOK_USER_ID=
FAL_JWKS_URL=https://rest.fal.ai/.well-known/jwks.json
VIDEO_PROVIDER_TIMEOUT_SECONDS=30
VIDEO_PROVIDER_RETRIES=2
VIDEO_MAX_DURATION_SECONDS=30
# Polling de fallback (webhook e preferencial quando FAL_WEBHOOK_URL existe).
VIDEO_POLL_ATTEMPTS=60
VIDEO_POLL_INTERVAL_SECONDS=2
# Upload de imagem para animar foto: MIME e tamanho validados no backend.
UPLOAD_MAX_BYTES=10485760
WEBHOOK_SIGNATURE_LEEWAY_SECONDS=300
JWKS_CACHE_TTL_SECONDS=3600
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=

# --- Pagamentos (somente backend) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Observabilidade ---
SENTRY_DSN=
LOG_LEVEL=INFO
